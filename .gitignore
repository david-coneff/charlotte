# Node
node_modules/

# Crawler (crawl.js) runtime outputs — generated per run, not source
crawl-report.html
crawl-report.json
crawl-allowlist.txt
crawl-allowlist.suggested.txt
crawl-progress.log
crawl-progress.part*.log
crawl-progress.manifest.json
crawl-seen.idx
crawl-state.jsonl
crawl-state.*.jsonl
crawl-gui-run.bat
crawl-gui-run.log
crawl-gui-err.log
crawl-gui-stop.flag
crawl-gui-pause.flag
crawl-gui-tune.json
# GUI default Start URLs — your personal list (the .example template stays tracked)
crawl-gui-domains.txt
# GUI default options — your personal overrides (the .example template stays tracked)
crawl-gui-config.txt
# crawl-render.js (browser second-opinion) outputs
crawl-render.json
render-report.html
crawl-report.json.bak

# NOTE: *.full.md (doc-graph render of CRAWLER/ etc.) is deliberately NOT
# ignored — it's committed (rhizome-protocol:rhiz-merkle.md §9.11), the one
# derived artifact meant to be read linearly on GitHub. The section files +
# _index.json remain the source of truth; `rhiz maintain` verifies the
# committed copy still matches them.

# rhiz tooling channel — gitignored: resolved tools cache + generated search index
.rhiz-tools/
.rhiz-search/

# rhiz-usage derived catalogs — local-only, rebuilt by `rhiz usage index`.
.rhiz-usage-catalog.json
.rhiz-doccoverage-stubs.json

# The `.rhiz/` runtime-state set (container-specific, never committed) — mirrors the
# anchor's canonical block (rhizome-memory:.gitignore). EL-148: a runtime-state file is
# part of a tool's interface, and a channel bless cannot deliver child .gitignore
# entries, so each child carries the list itself. Previously incomplete here — only
# .rhiz/subagent-findings/ was covered below, which is why .rhiz/access-log.jsonl ended
# up committed; corrected in the same change that untracked it.
.rhiz/loaded-units.json
.rhiz/read-mandate.json
.rhiz/checkpoint-tail-marker.json
.rhiz/expectations.*.json
.rhiz/partition-transition.json
.rhiz/model-windows.json
.rhiz/window-gap.*
.rhiz/channel-seen
.rhiz/transcript-ptr
.rhiz/context.*
.rhiz/milestone.*
.rhiz/session-start-shas.*
.rhiz/sync-nudge.*.json
.rhiz/census.*
.rhiz/census-milestone.*
.rhiz/refcapture.*.json
.rhiz/context-dismiss
.rhiz/access-log.jsonl
.rhiz/setup-ack
.rhiz/emission.*.json
.rhiz/injection-stats.jsonl

# Subagent durability checkpoints + the delegation ledger: per-session, per-agent partial
# findings written by a subagent under the SubagentStart mandate, plus the SubagentStop
# receipt/result record. Runtime state that exists to survive a SESSION, not to be
# committed — recovery reads it from disk.
.rhiz/subagent-findings/

# rhizome runtime state (`rhiz ignore-parity`) — machine-local, never committed.
# Mirrored from rhizome-protocol's own .gitignore, which is the canonical list
# because it is where a tool author already edits when they add a runtime file.
# Re-run `rhiz ignore-parity --fix` after pulling new tools; the drift is silent
# otherwise (EL-148: a channel bless ships tools, not a child's .gitignore).

.rhiz/context-journal.jsonl
.rhiz/watch-*.json
.rhiz/context-alert.json
.rhiz/binding-degraded
.rhiz/session-end-probe.jsonl
.rhiz/inject/
.rhiz/mandate-compliance.jsonl
