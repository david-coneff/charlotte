# Excludes rhizome/AI-assisted-development tooling from `git archive` output —
# GitHub's "Download ZIP", auto-generated release source tarballs, and Forgejo/Gitea
# archive downloads all shell out to `git archive`, so this is what makes THOSE
# specific downloads clean of AI-tooling files. It does NOT affect `git clone` (a
# clone gets every tracked file regardless of export-ignore; there is no git-native
# mechanism that filters clone contents by path) — see tools/strip-ai-artifacts.sh
# for that case, and rhiz-child-repo-convention.md for why these files are tracked
# on the working branch at all (the bootstrap problem, EL-152).
.rhiz-binding.json export-ignore
.rhiz-lint.json export-ignore
.rhiz-orphans.json export-ignore
.rhiz/ export-ignore
.claude/ export-ignore
tools/rhiz.py export-ignore
tools/strip-ai-artifacts.py export-ignore
.github/workflows/governance.yml export-ignore
.gitattributes export-ignore
